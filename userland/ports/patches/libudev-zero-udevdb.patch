+/* 9os: merge /run/udev/data/<id> (written by udevshim, systemd's format) into the device:
+ * E: properties, S: devlinks, G: tags; a device with a database entry is "initialized" */
+static void set_properties_from_db(struct udev_device *udev_device)
+{
+    const char *major, *minor, *subsystem, *ifindex, *sysname;
+    char id[512], path[PATH_MAX], line[LINE_MAX], *pos;
+    FILE *file;
+
+    major = udev_device_get_property_value(udev_device, "MAJOR");
+    minor = udev_device_get_property_value(udev_device, "MINOR");
+    subsystem = udev_device_get_subsystem(udev_device);
+    ifindex = udev_device_get_property_value(udev_device, "IFINDEX");
+    sysname = udev_device_get_sysname(udev_device);
+
+    if (major && minor) {
+        snprintf(id, sizeof(id), "%c%s:%s", subsystem && strcmp(subsystem, "block") == 0 ? 'b' : 'c', major, minor);
+    }
+    else if (ifindex && subsystem && strcmp(subsystem, "net") == 0) {
+        snprintf(id, sizeof(id), "n%s", ifindex);
+    }
+    else if (subsystem && sysname) {
+        snprintf(id, sizeof(id), "+%s:%s", subsystem, sysname);
+    }
+    else {
+        return;
+    }
+
+    snprintf(path, sizeof(path), "/run/udev/data/%s", id);
+    file = fopen(path, "r");
+
+    if (!file) {
+        return;
+    }
+
+    udev_device->initialized = 1;
+
+    /* the database is authoritative for input classification: drop the guessed ID_INPUT_* */
+    for (struct udev_list_entry *prev = &udev_device->properties, *e = prev->next; e; e = prev->next) {
+        if (e->name && strncmp(e->name, "ID_INPUT", 8) == 0) {
+            prev->next = e->next;
+            udev_list_entry_free(e);
+        }
+        else {
+            prev = e;
+        }
+    }
+
+    while (fgets(line, sizeof(line), file)) {
+        line[strcspn(line, "\n")] = '\0';
+
+        if (line[0] == '\0' || line[1] != ':') {
+            continue;
+        }
+
+        switch (line[0]) {
+        case 'E':
+            pos = strchr(line + 2, '=');
+
+            if (pos) {
+                *pos = '\0';
+                udev_list_entry_add(&udev_device->properties, line + 2, pos + 1, 1);
+            }
+
+            break;
+        case 'S':
+            snprintf(path, sizeof(path), "/dev/%s", line + 2);
+            udev_list_entry_add(&udev_device->devlinks, path, NULL, 0);
+            break;
+        case 'G':
+            udev_list_entry_add(&udev_device->tags, line + 2, NULL, 0);
+            break;
+        }
+    }
+
+    fclose(file);
+}
