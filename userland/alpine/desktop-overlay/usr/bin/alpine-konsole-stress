#!/bin/sh
# Run in a genuine UID1000 Wayland session; real QtWidgets/PTY lifecycle stress.
set -eu
[ "$(id -u)" = 1000 ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]
D=$(mktemp -d /tmp/alpine-konsole-stress-XXXXXX)
client=
cleanup() {
 r=$?
 if [ -n "$client" ];then
  kill "$client" 2>/dev/null || true
  for i in $(seq 30);do kill -0 "$client" 2>/dev/null || break;sleep .1;done
  kill -KILL "$client" 2>/dev/null || true;wait "$client" 2>/dev/null || true
 fi
 rm -rf "$D";exit "$r"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
for n in $(seq 8);do
 echo "KONSOLE_STRESS_LAUNCH=$n"
 konsole --separate --nofork -e /bin/sh -c "test -t 0 && tty > '$D/pty-$n';sleep .3" > "$D/client-$n.log" 2>&1 & client=$!
 deadline=$(( $(date +%s) + 60 ))
 while [ "$(date +%s)" -lt "$deadline" ];do
  [ ! -f "$D/pty-$n" ] || break
  kill -0 "$client" 2>/dev/null || break;sleep .1
 done
 if [ ! -f "$D/pty-$n" ] || ! grep -q '^/dev/pts/' "$D/pty-$n";then
  echo "alpine-konsole-stress: FAIL PTY launch=$n pid=$client"
  cat "$D/client-$n.log";ls -l "/proc/$client/fd" 2>/dev/null || true
  cat "/proc/$client/status" /proc/sched 2>/dev/null || true
  timeout -k 2 -s TERM 8 strace -f -tt -T -k -p "$client" -o "$D/blocked.trace" 2>&1 || true
  tail -n 160 "$D/blocked.trace" 2>/dev/null || true;exit 1
 fi
 deadline=$(( $(date +%s) + 30 ))
 while kill -0 "$client" 2>/dev/null && [ "$(date +%s)" -lt "$deadline" ];do sleep .1;done
 if kill -0 "$client" 2>/dev/null;then echo "alpine-konsole-stress: FAIL exit launch=$n pid=$client";exit 1;fi
 if wait "$client";then r=0;else r=$?;fi
 client=
 cat "$D/client-$n.log";cat "$D/pty-$n"
 [ "$r" = 0 ] || { echo "alpine-konsole-stress: FAIL status=$r launch=$n";exit 1; }
 echo "KONSOLE_STRESS_PASS=$n"
done
echo 'alpine-konsole-stress: PASSED eight genuine UID1000 QtWidgets PTY lifecycles'
