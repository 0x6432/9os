#!/bin/sh
# Real tiny diagnostic against explicit synthetic children, never GUI proof.
set -eu
D=$(mktemp -d /tmp/trace-snapshot-test-XXXXXX)
child=
cleanup() { [ -z "$child" ] || kill -KILL "$child" 2>/dev/null || true;rm -rf "$D"; }
trap cleanup EXIT HUP INT TERM
for mode in busy blocked stopped;do
 set +e
 (
  trace-snapshot-target "$mode" > "$D/target.out" 2>&1 &
  p=$!;echo "$p" > "$D/pid"
  # Do not attach in the fork/exec gap while the child still has the shell's
  # privilege/drop history. Require the plain target's own PID/mode witness.
  for i in $(seq 100);do grep -qx "SNAPSHOT_TARGET_READY pid=$p mode=$mode" "$D/target.out" && break;sleep .01;done
  grep -qx "SNAPSHOT_TARGET_READY pid=$p mode=$mode" "$D/target.out" || exit 2
  if [ "$mode" = stopped ];then
   for i in $(seq 100);do grep -q '^State:.*T' "/proc/$p/status" && break;sleep .01;done
   grep -q '^State:.*T' "/proc/$p/status" || exit 2
  fi
  # Replacing the direct parent also works with native Yama ptrace_scope=1;
  # no global security setting or child PR_SET_PTRACER bypass is needed.
  exec trace-snapshot "$p"
 ) > "$D/$mode.out" 2>&1
 rc=$?;set -e
 child=$(cat "$D/pid")
 if [ "$mode" = stopped ];then expected=1;else expected=0;fi
 if [ "$rc" != "$expected" ];then cat "$D/target.out" "$D/$mode.out";cat "/proc/$child/status" 2>/dev/null || true;exit 1;fi
 grep -q '^TracerPid:[[:space:]]*0$' "/proc/$child/status" || { cat "$D/$mode.out";exit 1; }
 kill -0 "$child"
 if [ "$mode" = stopped ];then
  grep -q '^State:.*T' "/proc/$child/status"
  grep -q 'phase=unexpected-stop' "$D/$mode.out"
  ! grep -q '^TRACE_SNAPSHOT_REGS' "$D/$mode.out"
 else
  grep -q '^TRACE_SNAPSHOT_DETACHED signal=0$' "$D/$mode.out"
  grep -q '^TRACE_SNAPSHOT_END result=0$' "$D/$mode.out"
  test "$(grep -c '^STACK ' "$D/$mode.out")" = 32
  ! grep -q '^State:.*[Tt]' "/proc/$child/status"
 fi
 kill -KILL "$child";child=
 echo "trace-snapshot-selftest: PASS synthetic $mode"
done
echo 'trace-snapshot-selftest: PASSED 3/3 synthetic process controls; not GUI proof'
