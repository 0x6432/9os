#!/bin/sh
# Genuine packaged UDisks enumeration; never modify, format or mount a device.
set -eu
# Acceptance is specifically the unprivileged desktop user, never a root fallback.
[ "$(id -u)" = 1000 ] || {
 echo 'alpine-udisks: enumeration requires uid=1000' >&2
 exit 1
}
D=$(mktemp -d /tmp/alpine-udisks-XXXXXX)
trap 'rm -rf "$D"' EXIT HUP INT TERM
timeout -s KILL 40 dbus-send --system --print-reply --reply-timeout=30000 \
 --dest=org.freedesktop.UDisks2 /org/freedesktop/UDisks2 \
 org.freedesktop.DBus.ObjectManager.GetManagedObjects > "$D/reply"
# This probe is for the real virtio disk-root desktop boot, not an empty daemon.
grep -Fq 'object path "/org/freedesktop/UDisks2/Manager"' "$D/reply"
grep -Fq 'object path "/org/freedesktop/UDisks2/block_devices/vda"' "$D/reply"
grep -Fq 'object path "/org/freedesktop/UDisks2/block_devices/vda1"' "$D/reply"
grep -Fq 'string "org.freedesktop.UDisks2.Filesystem"' "$D/reply"
grep -Fq 'array of bytes "/dev/vda1"' "$D/reply"
grep -Fq 'array of bytes "/"' "$D/reply"
# Independent text fragments above are necessary, but do not prove that Device
# and MountPoints belong to the expected objects/interfaces. Read those exact
# public properties as the same UID; any failed/denied call remains a failure.
# The enumeration deadline above is unchanged. Extra readbacks are bounded to
# 4s reply / 6s kill each, with no retries or fallback to privileged execution.
check_property() {
 property_call=$1 object=$2 interface=$3 property=$4 expected=$5
 property_reply="$D/property-$property_call"
 # Capture status explicitly so diagnostic work cannot overwrite the original
 # command/checker outcome. Fresh per-call files cannot replay an earlier reply.
 if timeout -s KILL 6 dbus-send --system --print-reply --reply-timeout=4000 \
  --dest=org.freedesktop.UDisks2 "$object" \
  org.freedesktop.DBus.Properties.Get "string:$interface" "string:$property" \
  > "$property_reply";then property_command_rc=0;else property_command_rc=$?;fi
 property_checker_rc=unknown
 if [ "$property_command_rc" = 0 ];then
  if python3 /usr/share/9os/udisks-property-check.py "$property" "$expected" "$property_reply";then
   property_checker_rc=0
  else property_checker_rc=$?;fi
 fi
 # Diagnostic only: <=3072 bytes + <=512-byte safe fallback per call, at most
 # three calls. Neither recording failure nor missing evidence changes acceptance.
 if python3 /usr/share/9os/udisks-readback-evidence.py "$property_call" "$property_command_rc" "$property_checker_rc" "$property_reply";then :;else
  printf '\nudisks_readback_v1 call=%s path=%s interface=%s property=%s bus=system destination=org.freedesktop.UDisks2 method=org.freedesktop.DBus.Properties.Get command_status=%s checker_status=%s recording=error typed=unknown capture=unknown complete=unknown truncated=unknown unknown=1 captured_bytes=unknown data_hex=unknown\n' \
   "$property_call" "$object" "$interface" "$property" "$property_command_rc" "$property_checker_rc" || true
 fi
 [ "$property_command_rc" = 0 ] || return "$property_command_rc"
 return "$property_checker_rc"
}
check_property 1 /org/freedesktop/UDisks2/block_devices/vda \
 org.freedesktop.UDisks2.Block Device /dev/vda
check_property 2 /org/freedesktop/UDisks2/block_devices/vda1 \
 org.freedesktop.UDisks2.Block Device /dev/vda1
check_property 3 /org/freedesktop/UDisks2/block_devices/vda1 \
 org.freedesktop.UDisks2.Filesystem MountPoints /
printf 'alpine-udisks: real disk/partition/root filesystem enumerated uid=%s\n' "$(id -u)"
