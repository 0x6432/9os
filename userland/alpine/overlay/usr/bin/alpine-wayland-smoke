#!/bin/sh
# Real Qt Quick xdg-shell surface, prebuilt Sway/pixman headless output.
# Headless output tests Wayland/composition, NOT KMS scanout or hardware GL.
set -eu
unset DISPLAY WAYLAND_DISPLAY SWAYSOCK QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML_IMPORT_PATH QML2_IMPORT_PATH
case ${ALPINE_WAYLAND_USER:-} in ''|user) ;; *) echo 'Unsupported test user'; exit 1;; esac
D=$(mktemp -d /tmp/alpine-wayland-XXXXXX)
client=; compositor=; SWAYSOCK=; expected_uid=0
cleanup() {
    [ -z "$client" ] || { kill "$client" 2>/dev/null || true; wait "$client" 2>/dev/null || true; }
    if [ -n "$compositor" ]; then
        [ -z "$SWAYSOCK" ] || swaymsg -q exit 2>/dev/null || true
        for i in $(seq 30); do kill -0 "$compositor" 2>/dev/null || break; sleep .1; done
        kill "$compositor" 2>/dev/null || true
        wait "$compositor" 2>/dev/null || true
    fi
    rm -rf "$D"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
export XDG_RUNTIME_DIR="$D" WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_HEADLESS_OUTPUTS=1 LANG=C.UTF-8
printf '%s\n' 'font monospace 10' 'output * resolution 128x96' 'default_border none' 'default_floating_border none' 'for_window [title="9os-alpine-wayland"] fullscreen enable' > "$D/config"
sway -d -c "$D/config" > "$D/sway.log" 2>&1 & compositor=$!
for i in $(seq 100); do
    for f in "$D"/sway-ipc.*; do [ ! -S "$f" ] || SWAYSOCK="$f"; done
    [ -z "$SWAYSOCK" ] || break
    kill -0 "$compositor" 2>/dev/null || break
    sleep .1
done
export SWAYSOCK
[ -n "$SWAYSOCK" ] || { cat "$D/sway.log"; echo 'alpine-wayland: FAIL startup'; exit 1; }
for f in "$D"/wayland-*; do [ ! -S "$f" ] || WAYLAND_DISPLAY="$f"; done
[ -n "${WAYLAND_DISPLAY:-}" ] || { cat "$D/sway.log"; echo 'alpine-wayland: FAIL socket'; exit 1; }
export WAYLAND_DISPLAY
C=$D/client; mkdir -m700 "$C"
export QV4_FORCE_INTERPRETER=1 QML_DISABLE_DISK_CACHE=1
case ${ALPINE_WAYLAND_RENDERER:-software} in
    software) export QT_QPA_PLATFORM=wayland QT_QUICK_BACKEND=software ;;
    opengl)
        unset QT_QUICK_BACKEND
        export QT_QPA_PLATFORM=wayland-egl QSG_RHI_BACKEND=opengl QSG_INFO=1
        export QSG_RENDER_LOOP=basic LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=softpipe ;;
    *) echo 'alpine-wayland: FAIL unsupported Quick renderer'; exit 1 ;;
esac
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1 QT_WAYLAND_SHELL_INTEGRATION=xdg-shell WAYLAND_DEBUG=client
if [ "${ALPINE_WAYLAND_USER:-}" = user ]; then
    expected_uid=1000
    chown 1000:1000 "$C" "$WAYLAND_DISPLAY"; chmod 600 "$WAYLAND_DISPLAY"; chmod 711 "$D"
    su user -s /bin/sh -c "cd '$C' && export XDG_RUNTIME_DIR='$C'; printf ALPINE_WAYLAND_CLIENT_UID=; id -u; exec /usr/lib/qt6/bin/qmlscene /usr/share/9os/alpine-wayland.qml" > "$C/client.log" 2>&1 & client=$!
else
    (cd "$C"; printf ALPINE_WAYLAND_CLIENT_UID=; id -u; exec /usr/lib/qt6/bin/qmlscene /usr/share/9os/alpine-wayland.qml) > "$C/client.log" 2>&1 & client=$!
fi
ready=0
for i in $(seq 100); do
    if grep -q 'alpine-wayland: READY frames' "$C/client.log"; then ready=1; break; fi
    kill -0 "$client" 2>/dev/null || break
    sleep .1
done
if [ "$ready" != 1 ]; then cat "$C/client.log" "$D/sway.log"; echo 'alpine-wayland: FAIL client readiness'; exit 1; fi
swaymsg -t get_tree > "$D/tree.json"
jq -e '.. | objects | select(.name? == "9os-alpine-wayland" and .shell? == "xdg_shell" and .visible? == true)' "$D/tree.json" >/dev/null || { cat "$D/tree.json"; echo 'alpine-wayland: FAIL mapped xdg-shell surface'; exit 1; }
# Capture the COMPOSITOR output, not a client-side grab or fake offscreen QPA.
unset WAYLAND_DEBUG
grim -o HEADLESS-1 "$D/output.png" || { cat "$D/sway.log"; echo 'alpine-wayland: FAIL compositor capture'; exit 1; }
echo ALPINE_WAYLAND_PNG_BEGIN
base64 "$D/output.png"
echo ALPINE_WAYLAND_PNG_END
echo "ALPINE_WAYLAND_TRACE_BEGIN uid=$expected_uid"
cat "$C/client.log"
echo ALPINE_WAYLAND_TRACE_END
wait "$client"; r=$?; client=
[ "$r" = 0 ] || { echo 'alpine-wayland: FAIL client status'; exit 1; }
swaymsg -q exit || true
for i in $(seq 30); do kill -0 "$compositor" 2>/dev/null || break; sleep .1; done
if kill -0 "$compositor" 2>/dev/null; then echo 'alpine-wayland: FAIL compositor exit'; exit 1; fi
wait "$compositor"; compositor=
echo 'alpine-wayland: PASSED (prebuilt Sway, mapped xdg-shell Quick, software compositor capture, clean exit)'
